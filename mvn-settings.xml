<?xml version="1.0" encoding="UTF-8"?>
<!--
	Minimal Maven settings that adds the TopLogic Nexus as both a regular
	repository and a plugin repository, so the tl-mcp-server plugin resolves
	AND the served project's TopLogic parent POM and dependencies resolve.
	Central remains the implicit default for everything else.

	This file is the source tl-mcp-serve.sh merges its toplogic-nexus profile
	from into the user's own ~/.m2/settings.xml (creating that file if it
	doesn't exist), rather than passing this file straight to 'mvn -s' -
	doing that would replace the user's settings for the run instead of
	merging with them, silently dropping any mirrors, server credentials, or
	localRepository override of their own. This file is only passed to
	'-s' directly as a fallback, if that merge itself fails.

	The <repositories> block is essential: the tl-mcp-server 'serve' goal reads
	the reactor project in the working directory, which requires resolving its
	TopLogic parent POM and dependencies. Those are normal artifacts, so a
	<pluginRepository> alone does not cover them — without a matching
	<repository> Maven falls back to Central, fails to find them, and the
	server aborts on startup.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

	<profiles>
		<profile>
			<id>toplogic-nexus</id>
			<repositories>
				<repository>
					<id>tl-releases</id>
					<url>https://dev.top-logic.com/nexus/repository/toplogic/</url>
					<releases><enabled>true</enabled></releases>
					<snapshots><enabled>false</enabled></snapshots>
				</repository>
				<repository>
					<id>tl-snapshots</id>
					<url>https://dev.top-logic.com/nexus/repository/toplogic-snapshots/</url>
					<releases><enabled>false</enabled></releases>
					<snapshots><enabled>true</enabled></snapshots>
				</repository>
			</repositories>
			<pluginRepositories>
				<pluginRepository>
					<id>tl-releases</id>
					<url>https://dev.top-logic.com/nexus/repository/toplogic/</url>
					<releases><enabled>true</enabled></releases>
					<snapshots><enabled>false</enabled></snapshots>
				</pluginRepository>
				<pluginRepository>
					<id>tl-snapshots</id>
					<url>https://dev.top-logic.com/nexus/repository/toplogic-snapshots/</url>
					<releases><enabled>false</enabled></releases>
					<snapshots><enabled>true</enabled></snapshots>
				</pluginRepository>
			</pluginRepositories>
		</profile>
	</profiles>

	<activeProfiles>
		<activeProfile>toplogic-nexus</activeProfile>
	</activeProfiles>

</settings>
